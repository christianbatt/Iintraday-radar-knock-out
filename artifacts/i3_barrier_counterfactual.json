      "ref": "calculator.ts:2236-2243"
    },
    {
      "sigla": "G9",
      "label": "Leva e barriera",
      "condizione": "esiste L in LEVE con dS*L <= LMAX e 1/L >= dS+BUF_BAR, e la barriera raccomandata dista >= BUF_BAR*E dallo stop",
