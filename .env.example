# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional Market Data API Keys for Finnhub or Twelve Data
# If not provided, the server uses the built-in live financial data adapter with caching.
FINNHUB_API_KEY=""
TWELVEDATA_API_KEY=""

# Optional Firebase Web API Key for external deployments
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_PROJECT_ID=""

# Server-only API keys for automation/Cloud Scheduler calls to protected API routes.
# Configure a strong random value in the deployment secret manager; never expose it to Vite/client code.
VALID_API_KEYS=""

# Optional server-side Firebase Admin configuration. Cloud Run can use its project ID and ADC.
FIREBASE_PROJECT_ID=""
FIRESTORE_DATABASE_ID="(default)"
AI_MEMORY_SYSTEM_UID="system"

# Fallback per il project ID Firebase quando FIREBASE_PROJECT_ID non e' impostato (Cloud Run, gcloud CLI).
# GOOGLE_CLOUD_PROJECT=
# GCLOUD_PROJECT=

# OPENROUTER_API_KEY: Chiave OpenRouter per catalizzatori AI
# Modello primario: nvidia/nemotron-3-ultra-550b-a55b:free
# Modello secondario: deepseek/deepseek-chat:free
# Fallback automatico: Google Gemini (gemini-3.8-flash)
OPENROUTER_API_KEY=""

# AUDIT D2 (IPOTESI, default OFF): riattiva il vecchio fail-open delle API protette per lo sviluppo locale.
# ALLOW_LEGACY_API_AUTH=true
