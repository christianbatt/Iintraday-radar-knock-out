# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional Market Data API Keys for Finnhub or Twelve Data
# If not provided, the server uses the built-in live financial data adapter with caching.
FINNHUB_API_KEY=""
TWELVEDATA_API_KEY=""

# Optional Firebase Web API Key for external deployments
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_PROJECT_ID=""

# Server-only API keys for automation/Cloud Scheduler calls to protected API routes.
# Configure a strong random value in the deployment secret manager; never expose it to Vite/client code.
VALID_API_KEYS=""

# Optional server-side Firebase Admin configuration. Cloud Run can use its project ID and ADC.
FIREBASE_PROJECT_ID=""
FIRESTORE_DATABASE_ID="(default)"
AI_MEMORY_SYSTEM_UID="system"

# Fallback per il project ID Firebase quando FIREBASE_PROJECT_ID non e' impostato (Cloud Run, gcloud CLI).
# GOOGLE_CLOUD_PROJECT=
# GCLOUD_PROJECT=

# OPENROUTER_API_KEY: Chiave OpenRouter per catalizzatori e desk AI
# Modello primario JSON-capable: google/gemma-4-26b-a4b-it:free
# Modello secondario JSON-capable: google/gemma-4-31b-it:free
# Fallback automatico: Google Gemini (gemini-4-hydrogen)
OPENROUTER_API_KEY=""

# Modelli OpenRouter configurabili (scelti tra i modelli :free con supporto nativo response_format json_object).
OPENROUTER_PRIMARY_MODEL="google/gemma-4-26b-a4b-it:free"
OPENROUTER_FALLBACK_MODEL="google/gemma-4-31b-it:free"
# Per default il chain-of-thought interno su OpenRouter e' disattivato (evita message.content vuoto su max_tokens).
# OPENROUTER_ENABLE_REASONING="false"

# AUDIT D2 (IPOTESI, default OFF): riattiva il vecchio fail-open delle API protette per lo sviluppo locale.
# ALLOW_LEGACY_API_AUTH=true

# Timeout chiamate esterne in millisecondi (default 10000) e TTL della cache Yahoo intraday 5m (default 25000).
# Valori assenti, non numerici o <= 0: il server usa i default.
EXTERNAL_FETCH_TIMEOUT_MS="10000"
YAHOO_CACHE_TTL_MS="25000"

# Scan di mercato in background all'avvio del server (default: attivo; gia' spento con NODE_ENV=test).
# Imposta true per disattivarlo.
# DISABLE_AUTO_MARKET_SCAN="true"

# Valutazione AI shadow automatica in background sulle scansioni durante orari di mercato attivo (default: attiva, cooldown 15m).
# DISABLE_AUTO_AI_SCAN_EVAL="true"

# Contratto anti-allucinazione AI Desk + Fascicolo Probatorio (default '1' in produzione/dev, '0' per disattivarlo).
AI_DESK_EVIDENCE="1"

# Sync Firestore del log shadow AI (default '1' in produzione/dev, '0' per disattivarlo).
# Se attivo, configurare una policy TTL sul campo `expiresAt` della collection
# `_system/ai_shadow_log/entries` nella console GCP/Firestore.
SHADOW_AI_LOG_FIRESTORE="1"
