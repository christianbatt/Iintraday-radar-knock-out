# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional Market Data API Keys for Finnhub or Twelve Data
# If not provided, the server uses the built-in live financial data adapter with caching.
FINNHUB_API_KEY=""
TWELVEDATA_API_KEY=""

# Optional Firebase Web API Key for external deployments
VITE_FIREBASE_API_KEY=""

# OPENROUTER_API_KEY: Chiave OpenRouter per catalizzatori AI
# Modello primario: nvidia/nemotron-3-ultra-550b-a55b:free
# Modello secondario: deepseek/deepseek-chat:free
# Fallback automatico: Google Gemini (gemini-3.8-flash)
OPENROUTER_API_KEY=""
