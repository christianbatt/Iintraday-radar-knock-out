rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTrade(data) {
      return data.id is string
        && data.ticker is string
        && (data.direction == 'LONG' || data.direction == 'SHORT' || data.direction == 'NESSUNA')
        && data.entryPrice is number
        && data.stopLoss is number
        && data.target1 is number
        && (data.status == 'OPEN' || data.status == 'CLOSED')
        && (data.outcome == 'WIN' || data.outcome == 'LOSS' || data.outcome == 'BREAKEVEN' || data.outcome == 'EXPIRED');
    }

    function isValidExcludedSetup(data) {
      return data.id is string
        && data.ticker is string
        && (data.market == 'EU' || data.market == 'US')
        && (data.direction == 'LONG' || data.direction == 'SHORT')
        && (data.outcomeStatus == 'MONITORING'
          || data.outcomeStatus == 'THEORETICAL_PROFIT'
          || data.outcomeStatus == 'THEORETICAL_STOP'
          || data.outcomeStatus == 'THEORETICAL_EXPIRED'
          || data.outcomeStatus == 'INSUFFICIENT_DATA');
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow write: if isOwner(userId);

      match /settings/system {
        allow get: if isOwner(userId);
        allow list: if false;
        // Governance: Direct updates to parameters are forbidden unless accompanied by an ACCEPTED proposal or initial write
        allow write: if isOwner(userId)
          && (
            resource == null
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['parameters'])
            || (
              request.resource.data.pendingProposal != null
              && request.resource.data.pendingProposal.status == 'ACCEPTED'
            )
          );
      }

      match /trades/{tradeId} {
        allow get: if isOwner(userId) && isValidId(tradeId);
        allow list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(tradeId) && isValidTrade(request.resource.data);
        allow delete: if isOwner(userId) && isValidId(tradeId);
      }

      match /excludedSetups/{excludedId} {
        allow get, list: if isOwner(userId) && isValidId(excludedId);
        allow create, update: if isOwner(userId)
          && isValidId(excludedId)
          && isValidExcludedSetup(request.resource.data);
        allow delete: if isOwner(userId) && isValidId(excludedId);
      }
    }
  }
}
